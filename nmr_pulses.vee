(device 106 MATLABSCRIPT
(properties
(variableScope cont)
(matlabexpr 55 "valid = 0;" "errorMessage = \'\';" "envelope = [];" "" "try"
"    if N < 2 || N ~= floor(N)" "        error(\'Invalid number of samples\');"
"    end" "" "    t = linspace(0,1,N);" ""
"    % Evaluate user-entered expression" "    envelope = eval(formula);" ""
"    % Expand scalar expressions" "    if isscalar(envelope)"
"        envelope = repmat(envelope,1,N);" "    end" "" "    % Check dimensions"
"    if ~isvector(envelope) || numel(envelope) ~= N"
"        error(\'Envelope must contain exactly N points\');" "    end" ""
"    envelope = reshape(envelope,1,N);" "" "    % Check numerical validity"
"    if ~isreal(envelope)" "        error(\'Complex envelope values\');"
"    end" "" "    if any(isnan(envelope)) || any(isinf(envelope))"
"        error(\'NaN or Inf detected\');" "    end" ""
"    if any(envelope < 0)" "        error(\'Negative envelope values\');"
"    end" "" "    % Normalize" "    peak = max(abs(envelope));" ""
"    if peak <= 0" "        error(\'Envelope is entirely zero\');" "    end" ""
"    envelope = envelope / peak;" "" "    valid = 1;" "" "catch ME"
"    envelope = [];" "    errorMessage = ME.message;" "    valid = 0;" "end"))
(interface
(input 1
(name "formula")
(optional yes))
(input 2
(name "N")
(optional yes))
(output 1
(name "envelope")
(optional yes))
(output 2
(name "valid")
(optional yes))
(output 3
(name "errorMessage")
(optional yes))))
(device 107 BREAK
(properties
(variableScope cont)))
