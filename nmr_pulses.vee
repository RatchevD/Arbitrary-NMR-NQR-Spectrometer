(device 248 MATLABSCRIPT
(properties
(name "CYCLOPS algorithm")
(variableScope cont)
(matlabexpr 39 "global nmrData nmrData2" "" "out1 = [];" "out2 = [];" ""
"A = double(A)\';" "" "% Initialize once" "if isFirst"
"    nmrData  = zeros(1,D);" "    nmrData2 = zeros(1,D);" "end" ""
"switch mod(B,4)" "" "    case 0" "        nmrData  =  nmrData + A(1:2:end);"
"        nmrData2 =  nmrData2 + A(2:2:end);" "" "    case 1"
"        nmrData2  = nmrData2 - A(1:2:end);"
"        nmrData=  nmrData + A(2:2:end);" "" "    case 2"
"        nmrData  = nmrData -A(1:2:end);"
"        nmrData2 = nmrData2-A(2:2:end);" "" "    case 3"
"        nmrData2  =  nmrData2 + A(1:2:end);"
"        nmrData = nmrData-A(2:2:end);" "" "end" "" "if isDone" ""
"    out1 = nmrData;" "    out2 = nmrData2;" "" "end"))
(interface
(input 1
(name "A")
(optional yes))
(input 2
(name "B")
(optional yes))
(input 3
(name "isDone")
(optional yes))
(input 4
(name "D")
(optional yes))
(input 5
(name "isFirst")
(optional yes))
(output 1
(name "out1")
(optional yes))
(output 2
(name "out2")
(optional yes))))
