(device 338 MATLABSCRIPT
(properties
(name "Phase Correction")
(variableScope cont)
(matlabexpr 16 "N = length(A);" "x = linspace(0,1, N)\';"
"initialGuess = [0, 0];" ""
"areaObjective = @(p) sum(abs(A .* cosd(p(1) + p(2).*x) - B .* sind(p(1) + p(2).*x)));"
"[p1, cost1] = fminsearch(areaObjective, initialGuess);" ""
"negativeObjective = @(p) sum(min(A .* cosd(p(1) + p(2).*x) - B .* sind(p(1) + p(2).*x), 0).^2);"
"[p2, cost2] = fminsearch(negativeObjective, p1);" "" "phi0 = p2(1);"
"phi1 = p2(2);" "" "phi = phi0 + phi1 .* x;"
"Rphased = A .* cosd(phi) - B .* sind(phi);"
"Iphased = A .* sind(phi) + B .* cosd(phi);"))
(interface
(input 1
(name "A")
(optional yes))
(input 2
(name "B")
(optional yes))
(output 1
(name "Rphased")
(optional yes))
(output 2
(name "Iphased")
(optional yes))
(output 3
(name "phi0")
(optional yes))
(output 4
(name "phi1")
(optional yes))))
