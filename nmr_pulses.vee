(device 411 MATLABSCRIPT
(properties
(name "Extract Area Under Lorentzian")
(variableScope cont)
(matlabexpr 20 "mask = (B > -20) & (B < 20)" "f_masked = B(mask);"
"mag_masked = A(mask);" ""
"lorentzian = @(p, f) p(3) * (p(2)/2)^2 ./ ((f - p(1)).^2 + (p(2)/2)^2) + p(4);"
"" "[A0, idx] = max(mag_masked);" "f0 = f_masked(idx);"
"gamma0 = (max(f_masked) - min(f_masked)) / 4;" "offset0 = min(mag_masked);" ""
"p0 = [f0, gamma0, A0 - offset0, offset0];" ""
"% minimize sum of squared residuals"
"cost = @(p) sum((lorentzian(p, f_masked) - mag_masked).^2);"
"popt = fminsearch(cost, p0);" "" "area = abs(popt(3)) * pi * abs(popt(2)) / 2;"
"" "fit_curve = lorentzian(popt, f_masked);"))
(interface
(input 1
(name "A")
(optional yes))
(input 2
(name "B")
(optional yes))
(output 1
(name "area")
(optional yes))
(output 2
(name "fit_curve")
(optional yes))
(output 3
(name "f_masked")
(optional yes))
(output 4
(name "mag_masked")
(optional yes))))
