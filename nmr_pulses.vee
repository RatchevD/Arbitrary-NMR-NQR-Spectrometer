(device 160 MATLABSCRIPT
(properties
(variableScope cont)
(matlabexpr 59 "" "valid = 0;" "errorMessage = \'\';" "waveform = [];" "" "try"
"    % Check pulse duration"
"    if ~isscalar(T) || ~isreal(T) || isnan(T) || isinf(T) || T <= 0"
"        error(\'Pulse duration must be a positive finite number\');" "    end"
"" "    % Check number of samples" "    if N < 2 || N ~= floor(N)"
"        error(\'Invalid number of samples\');" "    end" ""
"    % Generate time vector (0 to pulse duration)" "    t = (0:N-1)/(250e6);" ""
"    % Evaluate user-entered expression" "    waveform = eval(formula);" ""
"    % Expand scalar expressions" "    if isscalar(waveform)"
"        waveform = repmat(waveform,1,N);" "    end" "" "    % Check dimensions"
"    if ~isvector(waveform) || numel(waveform) ~= N"
"        error(\'Waveform must contain exactly N points\');" "    end" ""
"    waveform = reshape(waveform,1,N);" "" "    % Check numerical validity"
"    if ~isreal(waveform)" "        error(\'Complex waveform values\');"
"    end" "" "    if any(isnan(waveform)) || any(isinf(waveform))"
"        error(\'NaN or Inf detected\');" "    end" ""
"    % Normalize waveform" "    peak = max(abs(waveform));" ""
"    if peak <= 0" "        error(\'Waveform is entirely zero\');" "    end" ""
"    waveform = waveform / peak;" "" "    valid = 1;" "" "catch ME"
"    waveform = [];" "    errorMessage = ME.message;" "    valid = 0;" "end"))
(interface
(input 1
(name "formula")
(optional yes))
(input 2
(name "N")
(optional yes))
(input 3
(name "T")
(optional yes))
(output 1
(name "waveform")
(optional yes))
(output 2
(name "valid")
(optional yes))
(output 3
(name "errorMessage")
(optional yes))))
