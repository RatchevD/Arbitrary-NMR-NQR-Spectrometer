(variableScope cont)
(expr 11
"pulse2Array90[A] =envelopeArray[A] * DoubleAmp2.Value / max([DoubleAmp2.Value, DoubleAmp.Value]) * sin("
"    360 * (DoubleFreq2.Value - HalfSweepWurstDouble2.Value / 1000)"
