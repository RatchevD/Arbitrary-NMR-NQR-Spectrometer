(device 262 MATLABSCRIPT
(properties
(name "CYCLOPS algorithm")
(variableScope cont)
(matlabexpr 96 "global nmrData nmrData2" "" "out1 = [];" "out2 = [];" ""
"A = double(A)\';" "" "% Initialize once" "if isFirst"
"    nmrData  = zeros(1,D);" "    nmrData2 = zeros(1,D);" "end" "" "if spinEcho"
"    switch mod(B,8)" "" "        case 0"
"            nmrData  =  nmrData + A(1:2:end);"
"            nmrData2 =  nmrData2 + A(2:2:end);" "" "        case 1"
"            nmrData  = nmrData - A(1:2:end);"
"            nmrData2=  nmrData2 - A(2:2:end);" "" "        case 2"
"            nmrData  = nmrData  + A(1:2:end);"
"            nmrData2 = nmrData2 + A(2:2:end);" "" "        case 3"
"            nmrData  =  nmrData - A(1:2:end);"
"            nmrData2 = nmrData2 - A(2:2:end);" "        case 4"
"            nmrData2  =  nmrData2 - A(1:2:end);"
"            nmrData = nmrData + A(2:2:end);" "        case 5"
"            nmrData2  =  nmrData2 + A(1:2:end);"
"            nmrData = nmrData - A(2:2:end);" "        case 6"
"            nmrData2  =  nmrData2 - A(1:2:end);"
"            nmrData = nmrData + A(2:2:end);" "        case 7"
"            nmrData2  =  nmrData2 + A(1:2:end);"
"            nmrData = nmrData - A(2:2:end);" "    end" "elseif invReco"
"    switch mod(B,4)" "" "        case 0"
"            nmrData  =  nmrData + A(1:2:end);"
"            nmrData2 =  nmrData2 + A(2:2:end);" "" "        case 1"
"            nmrData2  = nmrData2 - A(1:2:end);"
"            nmrData=  nmrData + A(2:2:end);" "" "        case 2"
"            nmrData  = nmrData -A(1:2:end);"
"            nmrData2 = nmrData2-A(2:2:end);" "" "        case 3"
"            nmrData2  =  nmrData2 + A(1:2:end);"
"            nmrData = nmrData-A(2:2:end);" "" "    end" "elseif cyclops"
"    switch mod(B,4)" "" "        case 0"
"            nmrData  =  nmrData + A(1:2:end);"
"            nmrData2 =  nmrData2 + A(2:2:end);" "" "        case 1"
"            nmrData2  = nmrData2 - A(1:2:end);"
"            nmrData=  nmrData + A(2:2:end);" "" "        case 2"
"            nmrData  = nmrData -A(1:2:end);"
"            nmrData2 = nmrData2-A(2:2:end);" "" "        case 3"
"            nmrData2  =  nmrData2 + A(1:2:end);"
"            nmrData = nmrData-A(2:2:end);" "" "    end" "else"
"    nmrData = nmrData + A(1:2:end);" "    nmrData2 = nmrData2 + A(2:2:end);"
"end" "" "" "if isDone" "" "    out1 = nmrData;" "    out2 = nmrData2;" "" "end"
))
(interface
(input 1
(name "A")
(optional yes))
(input 2
(name "B")
(optional yes))
(input 3
(name "isDone")
(optional yes))
(input 4
(name "D")
(optional yes))
(input 5
(name "isFirst")
(optional yes))
(input 6
(name "spinEcho")
(optional yes))
(input 7
(name "invReco")
(optional yes))
(input 8
(name "cyclops")
(optional yes))
(output 1
(name "out1")
(optional yes))
(output 2
(name "out2")
(optional yes))))
