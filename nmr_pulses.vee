(device 442 MATLABSCRIPT
(properties
(name "Extract Trapezoidal Area")
(variableScope cont)
(matlabexpr 6 "mask = (B > -20) & (B < 20);" "f_masked = B(mask);"
"mag_masked = A(mask);" "" "baseline = min(mag_masked);"
"area = trapz(f_masked, mag_masked - baseline);"))
(interface
(input 1
(name "A")
(optional yes))
(input 2
(name "B")
(optional yes))
(output 1
(name "area")
(optional yes))
(output 2
(name "f_masked")
(optional yes))
(output 3
(name "mag_masked")
(optional yes))))
(device 443 LABEL
(properties
(name "Area Method:")
(variableScope cont)
(labelValue "Area Method:"))
(implementation))
(device 445 ENUMCONSTANT
(properties
(name "Drop-Down List")
(variableName AreaMethod)
(variableScope glob)
(initializeAtPrerun 1)
(enableEditing 1))
(interface
(output 1
(name "Enum")
(lock name constraints))
(output 2
(name "Ordinal")
(lock name constraints)))
(implementation
(value Enum
(values
("Lorentzian" 0)
("Trapezodial" 1))
(data  "Lorentzian"))
(initValue Text
(data  "Lorentzian"))))
(device 447 IFTHENELSE
(properties
(name "Lorentzian or Trapezoidal Area")
(variableScope cont)
(cases 1 "AreaMethod.EnumIndex==0000"))
(interface
(output 1
(name "Then")
(lock name constraints))
(output 2
(name "Else")
(lock name constraints))))
