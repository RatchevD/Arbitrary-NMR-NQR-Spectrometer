(device 44 TOFILE
(properties
(variableScope cont)
(transactions 33 "WRITE TEXT \"Nutation Curve PNMR/NQR Experiment\" EOL"
"WRITE TEXT A DATE:DMY TIME:HMS:H24 EOL" "WRITE TEXT \"\" EOL"
"WRITE TEXT \"GENERAL PULSE PARAMETERS\" EOL" "WRITE TEXT \"\" EOL"
"WRITE TEXT \"Sampling Rate (MSa/s): \"+NutationSR.Value EOL"
"WRITE TEXT \"Frequency (MHz): \"+NutationFreq.Value EOL"
"WRITE TEXT \"Amplitude (V_pp): \"+NutationAmp.Value EOL"
"WRITE TEXT \"Pulse Phase (Degrees): \"+NutationPulseP.Value EOL"
"WRITE TEXT \"Time Between Repetitions (s): \"+NutationPulseT.Value EOL"
"WRITE TEXT \"Number of Repetitions: \"+NutationSeqT.Value EOL"
"WRITE TEXT \"\" EOL" "WRITE TEXT \"PULSE WIDTH PARAMETERS\" EOL"
"WRITE TEXT \"\" EOL"
"WRITE TEXT \"Initial Pulse Length (us): \"+InitialPulseL.Value EOL"
"WRITE TEXT \"Final Pulse Length (us): \"+FinalPulseL.Value EOL"
"WRITE TEXT \"Step Size (us): \"+StepPulseL.Value EOL" "WRITE TEXT \"\" EOL"
"WRITE TEXT \"DATA  ACQUISITION PARAMETERS\" EOL" "WRITE TEXT \"\" EOL"
"WRITE TEXT \"Transient Delay (us): \"+NutationTDelay.Value EOL"
"WRITE TEXT \"Number of Acquisition Points: \"+NutationAcqPoints.Value EOL"
"WRITE TEXT \"Sampling Rate of Acquisiton (Sa/s): \"+NutationAcqSRate.Value EOL"
"WRITE TEXT \"\" EOL" "WRITE TEXT \"PHASE CYCLING PARAMETERS\" EOL"
"WRITE TEXT \"\" EOL" "WRITE TEXT \"Cycle: 4-step CYCLOPS\" EOL"
"WRITE TEXT \"Pulse Phases: 0-90-180-270\" EOL"
"WRITE TEXT \"Reciever Phases: 0-90-180-270\" EOL" "WRITE TEXT \"\" EOL"
"WRITE TEXT \"De-blanking Delay (ms): \"+NutationDeblankDelay.Value EOL"
"WRITE TEXT \"\" EOL" "WRITE TEXT \"Pulse Length (us), Lorentzian Area\" EOL"))
(interface
(input 1
(name "A")
(optional yes))
(input 2
(type control)
(name "File Name")
(requires
(datatype Text)
(shape "Scalar"))
(lock name constraints)
(optional yes)))
(implementation
(attr iopath file write
"C:\\P403 NMR Program - Ratchev\\403 Data\\Example\\FailedNutation.dat"
(readTerm "\n")
(fs "\t")
(eol "\r\n")
(multiField fullSyntax)
(arrayFormat block))))
