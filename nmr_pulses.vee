(device 36 TOFILE
(properties
(variableScope cont)
(transactions 31 "WRITE TEXT \"CPMG PNMR/NQR Experiment\" EOL"
"WRITE TEXT A DATE:DMY TIME:HMS:H24 EOL" "WRITE TEXT \"\" EOL"
"WRITE TEXT \"PULSE PARAMETERS\" EOL" "WRITE TEXT \"\" EOL"
"WRITE TEXT \"Frequency (MHz): \"+CPMGFreq.Value EOL"
"WRITE TEXT \"Sampling Rate (MSa/s): \"+CPMGSR.Value EOL"
"WRITE TEXT \"Amplitude (V_pp): \"+CPMGAmp.Value EOL"
"WRITE TEXT \"90 Degree Pulse Length (us): \"+CPMG90L.Value EOL"
"WRITE TEXT \"180 Degree Pulse Length (us): \"+CPMG180L.Value EOL"
"WRITE TEXT \"Interpulse Spacing (us): \"+CPMGInterSpc.Value EOL"
"WRITE TEXT \"Number of Echoes: \"+EchoNum.Value EOL"
"WRITE TEXT \"Time Between Repetitions (s): \"+CPMGPulseT.Value EOL"
"WRITE TEXT \"Number of Repetitions: \"+CPMGSeqT.Value EOL"
"WRITE TEXT \"\" EOL" "WRITE TEXT \"DATA  ACQUISITION PARAMETERS\" EOL"
"WRITE TEXT \"\" EOL"
"WRITE TEXT \"Transient Delay (us): \"+CPMGTDelay.Value EOL"
"WRITE TEXT \"Number of Acquisition Points: \"+CPMGAcqPoints.Value EOL"
"WRITE TEXT \"Sampling Rate of Acquisiton (Sa/s): \"+CPMGAcqSRate.Value EOL"
"WRITE TEXT \"\" EOL" "WRITE TEXT \"PHASE CYCLING PARAMETERS\" EOL"
"WRITE TEXT \"\" EOL" "WRITE TEXT \"Cycle: 4-step CYCLOPS\" EOL"
"WRITE TEXT \"90 Pulse Phases: 0-90-180-270\" EOL"
"WRITE TEXT \"180 Pulse Phases: 90-180-270-0\" EOL"
"WRITE TEXT \"Reciever Phases: 0-90-180-270\" EOL" "WRITE TEXT \"\" EOL"
"WRITE TEXT \"De-blanking Delay (ms): \"+CPMGDeblankDelay.Value EOL"
"WRITE TEXT \"\" EOL" "WRITE TEXT \"Time (ms), Real Data, Imaginary Data\" EOL")
)
(interface
(input 1
(name "A")
(optional yes))
(input 2
(type control)
(name "File Name")
(requires
(datatype Text)
(shape "Scalar"))
(lock name constraints)
(optional yes)))
(implementation
(attr iopath file write
"C:\\P403 NMR Program - Ratchev\\403 Data\\Example\\ExampleCPMG.dat"
(readTerm "\n")
(fs "\t")
(eol "\r\n")
(multiField fullSyntax)
(arrayFormat block))))
(device 37 FORCOUNT
(properties
(variableScope cont)
(count 40096))
(interface
(input 1
(name "Count")
(tag "Count")
(requires
(datatype Int32)
(shape "Scalar"))
(lock constraints)
(optional yes)
(buffer YES))
(output 1
(name "Count")
(lock name constraints))))
(device 38 FORMULA
(properties
(name "File + Extension")
(variableScope cont)
(expr 1 "A+\".dat\""))
(interface
(input 1
(name "A")
(optional yes))
(output 1
(name "Result")
(tag "Result")
(lock name constraints)
(optional yes))))
(device 41 FORMULA
(properties
(name "Time of Point")
(variableScope cont)
(expr 1 "A / CPMGAcqSRate.Value * 1000"))
(interface
(input 1
(name "A")
(optional yes))
(output 1
(name "Result")
(tag "Result")
(lock name constraints)
(optional yes))))
(device 42 FORMULA
(properties
(name "Get Imaginary Point")
(variableScope cont)
(expr 1 "(asReal32(A[B])/32768)*10"))
(interface
(input 1
(name "A")
(optional yes))
(input 2
(name "B")
(optional yes))
(output 1
(name "Result")
(tag "Result")
(lock name constraints)
(optional yes))))
(device 43 FORMULA
(properties
(name "Get Real Point")
(variableScope cont)
(expr 1 "(asReal32(A[B])/32768)*10"))
(interface
(input 1
(name "A")
(optional yes))
(input 2
(name "B")
(optional yes))
(output 1
(name "Result")
(tag "Result")
(lock name constraints)
(optional yes))))
(device 44 FORMULA
(properties
(name "Round Time")
(variableScope cont)
(expr 1 "round(A * 100000) / 100000"))
(interface
(input 1
(name "A")
(optional yes))
(output 1
(name "Result")
(tag "Result")
(lock name constraints)
(optional yes))))
(device 45 TOFILE
(properties
(variableScope cont)
(transactions 1 "WRITE TEXT B+\", \"+A+\", \"+C EOL"))
(interface
(input 1
(name "A")
(optional yes))
(input 2
(name "B")
(optional yes))
(input 3
(name "C")
(optional yes))
(input 4
(type control)
(name "File Name")
(requires
(datatype Text)
(shape "Scalar"))
(lock name constraints)
(optional yes)))
(implementation
(attr iopath file write
"C:\\P403 NMR Program - Ratchev\\403 Data\\Example\\ExampleCPMG.dat"
(readTerm "\n")
(fs "\t")
(eol "\r\n")
(multiField fullSyntax)
(arrayFormat block))))
(device 46 IFTHENELSE
(properties
(name "Phase Cycle Selection")
(variableScope cont)
(cases 4 "A==0000" "A==0001" "A==0002" "A==0003"))
(interface
(input 1
(name "A")
(optional yes))
(output 1
(name "Then")
(lock name constraints))
(output 2
(name "Else If")
(lock name constraints))
(output 3
(name "Else If")
(lock name constraints))
(output 4
(name "Else If")
(lock name constraints))
(output 5
(name "Else")
(lock name constraints))))
(device 48 TOFILE
(properties
(variableScope cont)
(transactions 28 "WRITE TEXT \"CPMG PNMR/NQR Experiment\" EOL"
"WRITE TEXT A DATE:DMY TIME:HMS:H24 EOL" "WRITE TEXT \"\" EOL"
"WRITE TEXT \"PULSE PARAMETERS\" EOL" "WRITE TEXT \"\" EOL"
"WRITE TEXT \"Frequency (MHz): \"+CPMGFreq.Value EOL"
"WRITE TEXT \"Sampling Rate (MSa/s): \"+CPMGSR.Value EOL"
"WRITE TEXT \"Amplitude (V_pp): \"+CPMGAmp.Value EOL"
"WRITE TEXT \"90 Degree Pulse Length (us): \"+CPMG90L.Value EOL"
"WRITE TEXT \"180 Degree Pulse Length (us): \"+CPMG180L.Value EOL"
"WRITE TEXT \"Interpulse Spacing (us): \"+CPMGInterSpc.Value EOL"
"WRITE TEXT \"Number of Echoes: \"+EchoNum.Value EOL"
"WRITE TEXT \"Time Between Repetitions (s): \"+CPMGPulseT.Value EOL"
"WRITE TEXT \"Number of Repetitions: \"+CPMGSeqT.Value EOL"
"WRITE TEXT \"\" EOL" "WRITE TEXT \"DATA  ACQUISITION PARAMETERS\" EOL"
"WRITE TEXT \"\" EOL"
"WRITE TEXT \"Transient Delay (us): \"+CPMGTDelay.Value EOL"
"WRITE TEXT \"Number of Acquisition Points: \"+CPMGAcqPoints.Value EOL"
"WRITE TEXT \"Sampling Rate of Acquisiton (Sa/s): \"+CPMGAcqSRate.Value EOL"
"WRITE TEXT \"\" EOL" "WRITE TEXT \"PHASE CYCLING PARAMETERS\" EOL"
"WRITE TEXT \"\" EOL" "WRITE TEXT \"Cycle: NONE\" EOL" "WRITE TEXT \"\" EOL"
"WRITE TEXT \"De-blanking Delay (ms): \"+CPMGDeblankDelay.Value EOL"
"WRITE TEXT \"\" EOL" "WRITE TEXT \"Time (ms), Real Data, Imaginary Data\" EOL")
)
(interface
(input 1
(name "A")
(optional yes))
(input 2
(type control)
(name "File Name")
(requires
(datatype Text)
(shape "Scalar"))
(lock name constraints)
(optional yes)))
(implementation
(attr iopath file write
"C:\\P403 NMR Program - Ratchev\\403 Data\\Example\\ExampleCPMG.dat"
(readTerm "\n")
(fs "\t")
(eol "\r\n")
(multiField fullSyntax)
(arrayFormat block))))
