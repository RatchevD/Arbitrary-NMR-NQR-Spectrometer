"        360 * (DoubleFreq2.Value + HalfSweepWurstDouble2.Value / 1000)"
"        * A / DoubleSR.Value" ""
"        - 360 * (HalfSweepWurstDouble2.Value / 1000)"
"        * (A / DoubleSR.Value)" "        * (A / DoubleSR.Value)"
"        / DoublePulseL2.Value" "" "        + DoublePulseP2.Value" "    );"))
(interface
(input 1
(name "A")
(optional yes))
(output 1
(name "Result")
(tag "Result")
(lock name constraints)
(optional yes))))
(device 98 FORMULA
(properties
(name "Add Pulse Point to timeArray")
(variableScope cont)
(expr 1
"timeArray[(A + (DoublePulseL.Value + 10) * DoubleSR.Value)] = (A + (DoublePulseL.Value + 10) * DoubleSR.Value) / DoubleSR.Value"
))
(interface
(input 1
(name "A")
(optional yes))
(output 1
(name "Result")
(tag "Result")
(lock name constraints)
(optional yes))))
