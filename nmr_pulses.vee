(variableScope cont)
(expr 3 "envelopeArray[A] = 1 / cosh("
"    BetaDouble.Value * (A / DoubleSR.Value - DoublePulseL.Value / 2)" ")"))
(interface
(input 1
(name "A")
(optional yes))
(output 1
(name "Result")
(tag "Result")
(lock name constraints)
(optional yes))))
