(expr 6 "pulseArray4[A] =envelopeArray[A] * sin("
"    360 * Freq.Value * A / SR.Value"
"    + (360 * HalfSweep.Value / (1000 * Beta.Value))"
"      * ln(cosh(Beta.Value * (A / SR.Value - PulseL.Value / 2)))"
"    + PulseP.Value+ 270" ")"))
(interface
(input 1
(name "A")
(optional yes))
(output 1
(name "Result")
(tag "Result")
(lock name constraints)
(optional yes))))
