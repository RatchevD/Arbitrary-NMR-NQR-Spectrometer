(properties
(name "Number of Cycles")
(variableScope cont)
(expr 1
"ceil(FreqArb.Value*10^6 * (sum(Duration) /(10^6)+PulseTArb.Value + DeblankDelayArb.Value / 10^(3) + TDelayArb.Value / 10^(6)))"
))
(interface
(output 1
(name "Result")
(tag "Result")
(lock name constraints)
(optional yes))))
(device 368 MATLABSCRIPT
(properties
(name "Phase cycling")
(variableScope cont)
(matlabexpr 28 "global nmrData nmrData2" "" "out1 = [];" "out2 = [];" ""
"A = double(A)\';" "" "% Initialize once" "if isFirst"
"    nmrData  = zeros(1,D);" "    nmrData2 = zeros(1,D);" "end" ""
"currentPhase = double(Phases(mod(double(B), double(cyclesNum)) + 1));" ""
"signal = A(1:2:end) + 1i * A(2:2:end);"
"rot_signal = signal * exp(-1i * currentPhase * (pi / 180));" ""
"nmrData = nmrData + real(rot_signal);"
"nmrData2 = nmrData2 + imag(rot_signal);" "" "" "if isDone" ""
"    out1 = nmrData;" "    out2 = nmrData2;" "" "end"))
(interface
(input 1
(name "A")
(optional yes))
(input 2
(name "B")
(optional yes))
(input 3
(name "isDone")
(optional yes))
(input 4
(name "D")
(optional yes))
(input 5
(name "isFirst")
(optional yes))
(input 6
(name "cyclesNum")
(optional yes))
(input 7
(name "Phases")
(optional yes))
(output 1
(name "out1")
(optional yes))
(output 2
(name "out2")
(optional yes))))
